+import assert from "node:assert/strict";
+import { test } from "node:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { fileURLToPath } from "node:url";
+import { CombinedAutocompleteProvider, KeybindingsManager, TUI_KEYBINDINGS, visibleWidth } from "@earendil-works/pi-tui";
+import type { ExtensionAPI, ExtensionContext, Theme } from "@earendil-works/pi-coding-agent";
+import { compactAutocomplete, DrawerMenu, drawerAction, registerUnifiedDrawer, readCommandMode, CATEGORY_ACTIONS } from "../../src/slash/unified-drawer.ts";
+import registerParent from "../../src/extension/index.ts";
+
+const ownPath = fileURLToPath(new URL("../../index.ts", import.meta.url));
+function host() {
+ const commands = new Map<string, any>(); const tools = new Map<string, any>(); const shortcuts = new Map<string, any>(); const events = new Map<string, Function[]>();
+ const noop = () => {};
+ const api = {
+  registerCommand: (name: string, value: any) => commands.set(name, value), registerTool: (value: any) => tools.set(value.name, value), registerShortcut: (name: string, value: any) => shortcuts.set(name, value),
+  on: (name: string, value: Function) => events.set(name, [...(events.get(name) ?? []), value]), events: { on: () => noop, emit: noop }, registerMessageRenderer: noop, registerEntryRenderer: noop,
+  getActiveTools: () => [], getAllTools: () => [], getCommands: () => [...commands.keys()].map((name) => ({ name, source: "extension", sourceInfo: { path: ownPath } })),
+ } as unknown as ExtensionAPI;
+ return { api, commands, tools, shortcuts, events };
+}
+const theme = { fg: (_color: string, text: string) => text } as Theme;
+const keys = new KeybindingsManager(TUI_KEYBINDINGS);
+
+test("full and compact register all 19 upstream commands and identical model schemas", () => {
+ const full = host(); const compact = host(); const child = process.env.PI_SUBAGENT_CHILD;
+ delete process.env.PI_SUBAGENT_CHILD;
+ try { registerUnifiedDrawer(full.api, registerParent, "full"); registerUnifiedDrawer(compact.api, registerParent, "compact"); }
+ finally { if (child !== undefined) process.env.PI_SUBAGENT_CHILD = child; }
+ const inventory = ["subagents", "run", "subagent-cost", "subagents-doctor", "subagents-inspect-rpc", "subagents-guide", "subagents-refine", "subagents-fleet", "subagents-detach", "subagents-stop", "subagents-steer", "prompt-workflow", "subagents-models", "subagents-profiles", "subagents-load-profile", "subagents-refresh-provider-models", "subagents-generate-profiles", "subagents-check-profile", "subagents-watchdog"].sort();
+ assert.deepEqual([...full.commands.keys()].sort(), inventory); assert.deepEqual([...compact.commands.keys()].sort(), inventory);
+ assert.deepEqual([...compact.tools.keys()], [...full.tools.keys()]);
+ for (const [name, tool] of full.tools) { assert.deepEqual(compact.tools.get(name).parameters, tool.parameters, name); assert.equal(compact.tools.get(name).description, tool.description, name); }
+});
+
+test("real base autocomplete is filtered, not supplemented; unrelated commands, arguments, skills and paths survive", async () => {
+ const base = new CombinedAutocompleteProvider([{ name: "subagents" }, { name: "subagents-fleet" }, { name: "subagents-inspect-rpc" }, { name: "sub-other" }, { name: "run", getArgumentCompletions: () => [{ value: "existing-agent" }] }, { name: "skill:pi-subagents" }], process.cwd());
+ const provider = compactAutocomplete(base, () => new Set(["subagents-fleet", "subagents-inspect-rpc", "run"]));
+ for (const prefix of ["/", "/sub"]) {
+  const result = await provider.getSuggestions([prefix], 0, prefix.length, {});
+  assert(result?.items.some((i) => i.value === "subagents")); assert(result?.items.some((i) => i.value === "sub-other"));
+  assert(!result?.items.some((i) => ["run", "subagents-fleet", "subagents-inspect-rpc"].includes(i.value)));
+ }
+ assert((await provider.getSuggestions(["/"],0,1,{}))?.items.some(i=>i.value==='skill:pi-subagents'));
+ for (const text of ["/run ", "./"]) assert.deepEqual(await provider.getSuggestions([text], 0, text.length, {}), await base.getSuggestions([text], 0, text.length, {}));
+ assert.deepEqual(provider.applyCompletion(["/sub"],0,4,{value:"subagents"},"/sub"),base.applyCompletion(["/sub"],0,4,{value:"subagents"},"/sub"));
+});
+
+test("TUI-only provenance filter preserves another extension's same-name alias", async () => {
+ const h = host(); registerUnifiedDrawer(h.api, api => { api.registerCommand('subagents',{handler:async()=>{}}); api.registerCommand('run',{handler:async()=>{}}); },'compact');
+ h.api.getCommands = () => [{name:'run:1',source:'extension',sourceInfo:{path:ownPath}},{name:'run:2',source:'extension',sourceInfo:{path:'/other/index.ts'}}] as any;
+ let wrapper: any; const ctx = {mode:'tui',ui:{addAutocompleteProvider:(w:any)=>{wrapper=w;}}};
+ for(const mode of ['rpc','print','json']) { h.events.get('session_start')![0]!({}, {...ctx,mode}); assert.equal(wrapper,undefined); }
+ h.events.get('session_start')![0]!({},ctx);
+ const result = await wrapper(new CombinedAutocompleteProvider([{name:'run:1'},{name:'run:2'}],process.cwd())).getSuggestions(['/'],0,1,{});
+ assert.deepEqual(result.items.map((i:any)=>i.value),['run:2']);
+});
+
+test("bounded theme/control-safe render, resize, keyboard focus and back", () => {
+ let result: string|undefined = 'pending'; let height=24; let color='';
+ const menu = new DrawerMenu('Danger\x1b]52;c;bad\x07 title',['Runs','Agents','界'.repeat(50)],()=>({fg:(_:string,s:string)=>color+s+(color?'\x1b[0m':'')}) as Theme,keys,()=>height,v=>{result=v;});
+ for(const w of [0,1,2,7,20,80,200]) for(const rows of [1,2,3,24]) {height=rows; const lines=menu.render(w);assert(lines.length<=rows); assert(lines.every(line=>visibleWidth(line)<=w&&!line.includes(']52;')));}
+ height=24;color='\x1b[31m';menu.invalidate();assert(menu.render(80)[0]!.includes(color));
+ menu.handleInput('\x1b[B');menu.handleInput('\r');assert.equal(result,'Agents');menu.handleInput('\x1b');assert.equal(result,undefined);
+});
+
+function actionFixture() {
+ const calls:any[]=[];
+ const actions={workflowNames:()=>[] as string[],command:async(...args:any[])=>{calls.push(args.slice(0,2));},manage:async(...args:any[])=>{calls.push(args[0]);}};
+ const ctx={ui:{input:async()=>undefined,editor:async()=>undefined,select:async()=>undefined,confirm:async()=>false,notify:()=>{}}} as unknown as ExtensionContext;
+ return {calls,actions,ctx};
+}
+
+test("read-only navigation uses original views; absent workflows and cancelled forms execute nothing", async()=>{
+ const {calls,actions,ctx}=actionFixture();
+ for(const label of ['Fleet','Browse / edit agents','Costs','List prompt workflows','Workflow help','Help']) await drawerAction(label,ctx,actions,new AbortController().signal);
+ assert.deepEqual(calls.map(c=>c[0]),['subagents-fleet','subagents','subagent-cost','subagents-guide','subagents-guide']);calls.length=0;
+ for(const label of Object.values(CATEGORY_ACTIONS).flat().filter(l=>l.endsWith('…')&&l!=='Stop…')) await drawerAction(label,ctx,actions,new AbortController().signal);
+ assert.deepEqual(calls,[]);
+ ctx.ui.editor=async()=>'{"action":"schedule.run"}';await assert.rejects(drawerAction('Create agent…',ctx,actions,new AbortController().signal),/selected management action/);
+ ctx.ui.editor=async()=>'{"action":"create","config":{"name":"custom"}}';await drawerAction('Create agent…',ctx,actions,new AbortController().signal);assert.deepEqual(calls,[]);
+ ctx.ui.confirm=async()=>true;await drawerAction('Create agent…',ctx,actions,new AbortController().signal);assert.equal(calls[0].action,'create');
+});
+
+test("schedule/mission guided actions retain selected action, confirm mutations and honor cancellation",async()=>{
+ const {calls,actions,ctx}=actionFixture();const controller=new AbortController();
